# Copy this file to .env and fill in real values. Never commit .env.

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=vecoassets
POSTGRES_USER=vecoassets
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- Backend (Spring Boot) ---------------------------------------------------
# Used directly when running the backend outside Docker (mvn spring-boot:run).
# Inside docker-compose, DATABASE_URL/USERNAME/PASSWORD are derived from the
# POSTGRES_* variables above instead.
DATABASE_URL=jdbc:postgresql://localhost:5432/vecoassets
DATABASE_USERNAME=vecoassets
DATABASE_PASSWORD=change-me

# Generate a long random value, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-generate-a-real-secret
JWT_EXPIRATION_MINUTES=480

CORS_ALLOWED_ORIGINS=http://localhost:5173
SERVER_PORT=8080
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev

ASSET_CODE_PREFIX=VECO-IMM
ASSET_CODE_START=1

# --- Frontend (Vite) ----------------------------------------------------------
FRONTEND_PORT=5173
VITE_API_PROXY_TARGET=http://localhost:8080
